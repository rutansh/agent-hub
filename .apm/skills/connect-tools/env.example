# Credentials for the tools your agent uses.
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in only the tools you use. Leave the rest empty.
# 3. Load and check:   source .agents/skills/connect-tools/scripts/connect.sh
#
# .env is git-ignored. Never commit it. Never paste these values into chat.
# Values with spaces must be quoted.

# --- GitHub (gh) ------------------------------------------------------------
# Used for: chained PRs when your repo is on GitHub.
# Token: https://github.com/settings/tokens  (scope: repo)
# gh reads GH_TOKEN directly from the environment.
GH_TOKEN=
# Only for GitHub Enterprise. Leave empty for github.com.
GH_HOST=

# --- GitLab (glab) ----------------------------------------------------------
# Used for: stacked merge requests (glab stack) when your repo is on GitLab.
# Token: GitLab > Preferences > Access tokens  (scopes: api, write_repository)
# glab reads GITLAB_TOKEN and GITLAB_HOST directly from the environment.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com

# --- Jira (acli) ------------------------------------------------------------
# Used for: creating the epic and tickets.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# acli does NOT read these names itself. connect.sh logs acli in with them.
JIRA_SITE=yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Default Jira project key for new tickets, for example PAY
JIRA_PROJECT_KEY=
